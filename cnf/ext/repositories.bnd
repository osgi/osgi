-plugin.repositories = \
    aQute.lib.deployer.FileRepo; \
        name='Main'; \
        location="${mainrepo}"; \
        readonly=true, \
    aQute.lib.deployer.FileRepo; \
        name='Licensed'; \
        location="${licensedrepo}"; \
        readonly=true, \
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name='Maven Central';\
        releaseUrl="${centralrepo},${uri;${bnd_releases}}";\
        snapshotUrl="${uri;${bnd_snapshots}},${ossrhrepo},${apachesnapshotrepo}";\
        index=${.}/central.mvn;\
        readOnly=true,\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name='Local';\
        noupdateOnRelease=true,\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name='Release';\
        releaseUrl="${fileuri;${releaserepo}}";\
        snapshotUrl="${fileuri;${releaserepo}}";\
        noupdateOnRelease=true,\
    aQute.bnd.repository.maven.provider.MavenBndRepository;\
        name='Baseline';\
        releaseUrl="${centralrepo}";\
        index=${.}/baseline.mvn;\
        readOnly=true

# Retained for dependency *resolution* only: this repo's default index is
# cnf/ossrh.mvn, the sole index listing the org.eclipse.osgi-technology
# webservices runtime registrar SNAPSHOT that the build needs. Publishing no
# longer uses OSSRH: it now writes to the local 'Release' repo, which
# .github/scripts/sonatype-upload.sh uploads to the Sonatype Central Portal —
# so the OSSRH staging releaseUrl has been dropped. Do not rename: the name
# 'OSSRH' is tied to the cnf/ossrh.mvn index filename.
-plugin.repositories.ossrh: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        name='OSSRH'; \
        snapshotUrl="${first;${env;OSSRH_SNAPSHOT};https://central.sonatype.com/repository/maven-snapshots/}"; \
        noupdateOnRelease=true

# Publish target for CI deploys to the Sonatype Central Portal. bnd routes by version:
#   - SNAPSHOT versions  -> snapshotUrl (Central snapshot repo, HTTP, token auth). Sonatype
#                           did not change how snapshots are published, only the URL, so
#                           this half is unchanged from the previous OSSRH setup.
#   - release versions   -> releaseUrl  (local staging dir, then uploaded to Central as a
#                           bundle by .github/scripts/sonatype-upload.sh)
#
# The release half deliberately points at ${publishstagerepo} and not at ${releaserepo}.
# ${releaserepo} is the 'Release' repo, which receives *every* project via -releaserepo,
# whereas this repo is reached through -releaserepo.publish (cnf/includes/publish.bnd and
# tck.bnd) and so receives only what passes the baseline gate — the artifacts whose version
# differs from the last released one. Uploading the staging dir therefore cannot re-submit
# an already released GAV, which the Central Portal rejects as a duplicate.
-plugin.repositories.centralpublish: \
    aQute.bnd.repository.maven.provider.MavenBndRepository; \
        name='CentralPublish'; \
        snapshotUrl="${ossrhrepo}"; \
        releaseUrl="${fileuri;${publishstagerepo}}"; \
        noupdateOnRelease=true

# Route publishing to Central only when the Central token is present (CI); otherwise
# publish to the local 'Release' file repo so local release builds keep working offline.
publishrepo: ${if;${env;CENTRAL_SONATYPE_TOKEN_USERNAME};CentralPublish;Release}
-connection-settings.publish: ${if;${env;CENTRAL_SONATYPE_TOKEN_USERNAME};${.}/central-settings.xml}
gpg: ${if;${env;GPG_PASSPHRASE};gpg --pinentry-mode=loopback;gpg}

-buildrepo: Local
-releaserepo: Release
-baselinerepo: Baseline

-maven-release: pom;path=JAR,javadoc;path=NONE,sources;path=NONE
